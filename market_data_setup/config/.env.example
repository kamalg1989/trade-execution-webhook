# ============================================================
# Environment Configuration for Market Data API
# Copy to /root/trade-execution-webhook/.env and fill in values
# ============================================================

# ============================================================
# DHAN API CREDENTIALS (Required)
# ============================================================
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_PIN=your_dhan_pin
DHAN_TOTP_SECRET=your_dhan_totp_secret

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=market_data_user
DB_PASSWORD=your_secure_database_password
DB_NAME=market_data

# ============================================================
# API CONFIGURATION (Optional)
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_LOG_LEVEL=info

# ============================================================
# EXISTING CONFIGURATION (From your .env)
# ============================================================
TELEGRAM_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id
DHAN_CLIENT_ID=your_dhan_id
DHAN_PIN=your_dhan_pin
DHAN_TOTP_SECRET=your_totp_secret
CAPITAL=1000000
MAX_OPEN_RISK_PCT=0.10
SPREADSHEET_ID=your_google_sheet_id
SERVICE_ACCOUNT_KEY_PATH=/path/to/service_account.json
SL_TELEGRAM_TOKEN=your_sl_token
SL_TELEGRAM_CHAT_ID=your_sl_chat_id
SL_ENGINE_DRY_RUN=false
OPENAI_API_KEY=your_openai_key
GITHUB_REPO=your_repo
GITHUB_TOKEN_CUSTOM=your_github_token
