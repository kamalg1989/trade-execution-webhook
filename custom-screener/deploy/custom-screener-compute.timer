[Unit]
Description=Run Custom Screener compute daily at 18:30 IST (after 18:00 OHLCV update)

[Timer]
# Fires at 18:30 in the server's local timezone. The VPS is Asia/Kolkata (IST),
# so this is 18:30 IST — after market close (15:30) and the 18:00 OHLCV update.
OnCalendar=*-*-* 18:30:00
Persistent=true
Unit=custom-screener-compute.service

[Install]
WantedBy=timers.target
