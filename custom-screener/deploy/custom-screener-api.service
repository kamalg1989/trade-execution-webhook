[Unit]
Description=Custom Screener API (FastAPI, :8005)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/trade-execution-webhook/custom-screener/backend
# Reuse the existing platform .env (has DB_HOST/PORT/USER/PASSWORD/NAME).
EnvironmentFile=/root/trade-execution-webhook/.env
# Live: uses the repo venv python (deploy_vps.sh sets this automatically).
ExecStart=/root/trade-execution-webhook/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8005
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
