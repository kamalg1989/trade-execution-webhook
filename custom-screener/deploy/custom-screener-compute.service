[Unit]
Description=Custom Screener nightly indicator compute
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/trade-execution-webhook/custom-screener/backend
# Reuse the existing platform .env (shared DB creds).
EnvironmentFile=/root/trade-execution-webhook/.env
# Incremental: computes the latest available bar date + snapshot.
ExecStart=/root/trade-execution-webhook/venv/bin/python -m compute.compute_stock_indicators
