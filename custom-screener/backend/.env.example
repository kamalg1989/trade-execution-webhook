# Custom Screener backend — copy to .env and fill in.
# Shares the existing PostgreSQL + TimescaleDB (read-only use here).
DB_HOST=localhost
DB_PORT=5432
DB_USER=market_data_user
DB_PASSWORD=
DB_NAME=market_data

CUSTOM_SCREENER_PORT=8005
# Backend serves /api/... ; nginx maps /custom-screener/api/ here. Leave ROOT_PATH empty.
CUSTOM_SCREENER_ROOT_PATH=
SNAPSHOT_COMPLETE_THRESHOLD=2600
