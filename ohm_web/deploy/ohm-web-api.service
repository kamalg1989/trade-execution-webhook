[Unit]
Description=OHM full-setup web API (/ohm/, port 8009)
After=network.target postgresql.service

[Service]
WorkingDirectory=/root/ohm_web
ExecStart=/root/trade-execution-webhook/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8009 --workers 1
Restart=always
RestartSec=5
MemoryMax=400M

[Install]
WantedBy=multi-user.target
